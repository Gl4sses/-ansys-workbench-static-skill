# Template for the separately installed Workbench MCP server.
# The standalone runner does not load this file automatically.
ANSYS_ROOT=C:\Program Files\ANSYS Inc\v192
ANSYS_WB_EXE=C:\Program Files\ANSYS Inc\v192\Framework\bin\Win64\RunWB2.exe
WORKBENCH_MCP_ROOT=C:\cae-tools\WorkbenchMCP
WORKBENCH_MCP_QUEUE_ROOT=C:\cae-runs\interactive-queue
WORKBENCH_MCP_HOST=127.0.0.1
WORKBENCH_MCP_PORT=9885
WORKBENCH_MCP_AUTO_START_SOCKET=0
WORKBENCH_MCP_AUTO_START_QUEUE=1
WORKBENCH_MCP_QUEUE_INTERVAL_MS=1500
ANSYS_FEA_RUNTIME_ROOT=C:\cae-runs\runtime
